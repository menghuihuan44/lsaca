fn main() {
    let mut words: HashSet<String> = HashSet::new();
    println!("insert {} {} {}", words.insert(String::from("beta")), words.insert(String::from("beta")), words.insert(String::from("alpha")));
    println!("elements {:?}", words.elements());
    println!("contains {} {}", words.contains(String::from("alpha")), words.contains(String::from("gamma")));
    println!("remove {} {}", words.remove(String::from("alpha")), words.remove(String::from("alpha")));
    println!("after remove {:?} len {}", words.elements(), words.len());
    words.clear();
    println!("cleared {} {}", words.len(), words.is_empty());
    let mut left: HashSet<i64> = HashSet::new();
    let mut right: HashSet<i64> = HashSet::new();
    left.insert(1);
    left.insert(2);
    left.insert(3);
    right.insert(2);
    right.insert(3);
    right.insert(4);
    println!("union {:?}", left.union(&right).elements());
    println!("intersection {:?}", left.intersection(&right).elements());
    println!("difference {:?}", left.difference(&right).elements());
    println!("subset {} {}", left.subset(&right), right.subset(&left));
    let mut ordered: BTreeSet<i64> = BTreeSet::new();
    println!("btree empty {} {}", ordered.is_empty(), ordered.first().is_none());
    ordered.insert(9);
    ordered.insert(2);
    ordered.insert(5);
    ordered.insert(2);
    ordered.insert(-1);
    println!("btree {:?} first {} last {}", ordered.elements(), ordered.first().unwrap(), ordered.last().unwrap());
    println!("btree contains {} {}", ordered.contains(5), ordered.contains(7));
    println!("btree remove {} {}", ordered.remove(2), ordered.remove(2));
    println!("btree after {:?}", ordered.elements());
    let mut labels: BTreeSet<String> = BTreeSet::new();
    labels.insert(String::from("pear"));
    labels.insert(String::from("apple"));
    labels.insert(String::from("fig"));
    println!("labels {:?}", labels.elements());
    let mut table: BTreeMap<String, i64> = BTreeMap::new();
    println!("map insert {:?} {:?} {:?}", table.insert(String::from("b"), 2), table.insert(String::from("a"), 1), table.insert(String::from("b"), 20));
    println!("map keys {:?} values {:?}", table.keys(), table.values());
    println!("map get {:?} {:?}", table.get(String::from("a")), table.get(String::from("zzz")));
    println!("map contains {} {}", table.contains_key(String::from("b")), table.contains_key(String::from("zzz")));
    println!("map remove {:?} {:?}", table.remove(String::from("a")), table.remove(String::from("a")));
    println!("map len {} {:?}", table.len(), table.keys());
    let mut deque: VecDeque<i64> = VecDeque::new();
    println!("deque empty {} {} {}", deque.is_empty(), deque.pop_front().is_none(), deque.pop_back().is_none());
    deque.push_back(2);
    deque.push_front(1);
    deque.push_back(3);
    deque.push_front(0);
    println!("deque {:?} len {}", deque.elements(), deque.len());
    println!("deque pop {} {}", deque.pop_front().unwrap(), deque.pop_back().unwrap());
    println!("deque get {:?} {:?} {:?}", deque.get(0), deque.get(1), deque.get(2));
    let mut heap: BinaryHeap<i64> = BinaryHeap::new();
    heap.push(3);
    heap.push(9);
    heap.push(3);
    heap.push(5);
    println!("heap {:?} peek {:?}", heap.elements(), heap.peek());
    println!("heap pop {} {} {}", heap.pop().unwrap(), heap.pop().unwrap(), heap.pop().unwrap());
    println!("heap left {} peek {:?}", heap.len(), heap.peek());
    heap.clear();
    println!("heap cleared {} {}", heap.len(), heap.is_empty());
}
