fn main() {
    let mut empty: Vec<i64> = Vec::new();
    println!("empty {} {}", empty.len(), empty.is_empty());
    println!("pop none {}", empty.pop().is_none());
    println!("first none {}", empty.first().is_none());
    println!("last none {}", empty.last().is_none());
    let mut values: Vec<i64> = Vec::with_capacity(2);
    values.push(5);
    values.push(3);
    values.push(9);
    values.push(3);
    println!("len {} empty {}", values.len(), values.is_empty());
    println!("first {} last {}", values.first().unwrap(), values.last().unwrap());
    println!("get 0 {} get 3 {} get 4 {}", values.get(0).unwrap(), values.get(3).unwrap(), values.get(4).is_none());
    values.insert(0, 7);
    values.insert(5, 1);
    println!("inserted {:?}", values);
    println!("removed {} {:?}", values.remove(0), values);
    values.reverse();
    println!("reversed {:?}", values);
    let mut more: Vec<i64> = Vec::new();
    more.push(100);
    more.push(200);
    values.extend(more);
    println!("extended {:?}", values);
    println!("slice len {} empty {}", values.as_slice().len(), values.as_slice().is_empty());
    empty.push(1);
    empty.sort();
    println!("sorted single {:?}", empty);
    let mut negatives: Vec<i64> = Vec::new();
    negatives.push(0);
    negatives.push(-4);
    negatives.push(12);
    negatives.push(-1);
    negatives.sort();
    println!("sorted negatives {:?}", negatives);
    let mut names: Vec<String> = Vec::new();
    names.push(String::from("zed"));
    names.push(String::from("ann"));
    names.push(String::from("bob"));
    names.push(String::from("ann"));
    names.sort();
    println!("sorted names {:?}", names);
    let removed = names.remove(0);
    println!("removed name {} remaining {}", removed, names.len());
    let mut floats: Vec<f64> = Vec::new();
    floats.push(2.5);
    floats.push(0.5);
    floats.push(1.25);
    floats.sort();
    println!("sorted floats {:?}", floats);
    values.clear();
    println!("cleared {} {}", values.len(), values.is_empty());
}
